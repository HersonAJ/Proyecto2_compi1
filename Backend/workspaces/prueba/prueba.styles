/* Prueba de colores para .styles */

mi-clase {
    height = 100;
    width = 200;
    background color = lightgray;
    color = blue;
    text size = 14;
    border = 2 solid red;
    padding = 10;
}

@for $i from 1 through 4 {
    titulo-$i {
        text size = $i * 10;
        margin top = $i * 5;
    }
}

@for $j from 0 to 3 {
    item-$j {
        width = $j * 25;
    }
}

estilo-hijo extends mi-clase {
    color = white;
    border color = green;
}