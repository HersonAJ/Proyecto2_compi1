/* Estilo base de tarjeta */
tarjeta {
    background color = #f5f5f5;
    color = black;
    padding = 20;
    border = 2 solid #2563eb;
    border radius = 12;
    text size = 14;
}

/* Herencia: tarjeta con tema azul */
tarjeta-azul extends tarjeta {
    background color = #2563eb;
    color = white;
    border = 3 solid #1e40af;
}

/* Encabezado del nombre */
nombre-grande {
    text size = 28;
    color = #1e40af;
    text align = CENTER;
}

/* Texto de informacion (campos del CV) */
campo {
    text size = 16;
    padding = 4;
    color = #374151;
}

/* Etiqueta de habilidad */
habilidad {
    background color = lightgray;
    color = black;
    padding = 6;
    border radius = 8;
    text size = 12;
    margin = 4;
}

/* Bucle @for: tres niveles de seccion con tamanos crecientes */
@for $i from 1 through 3 {
    seccion-$i {
        text size = $i * 6 + 10;
        padding = $i * 4;
        color = #1e40af;
    }
}